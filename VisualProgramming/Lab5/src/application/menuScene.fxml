      </GridPane>
      <TextField fx:id="errorMessageField" alignment="CENTER" prefHeight="43.0" prefWidth="600.0" style="-fx-text-fill: red;" stylesheets="@../../../Lab4/src/application/application.css" text=" There cannot be any empty fields" />
